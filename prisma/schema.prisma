generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("WUWA_PRISMA_DATABASE_URL")
  directUrl = env("WUWA_DATABASE_URL")
}

enum BannerType {
  CHARACTER
  WEAPON
}

enum PullResult {
  WIN
  LOSE
}

model BalanceEntry {
  id        String   @id @default(cuid())
  date      DateTime
  amount    Int
  createdAt DateTime @default(now())
}

model SpendEntry {
  id         String     @id @default(cuid())
  date       DateTime
  amount     Int
  category   BannerType
  bannerName String?
  note       String?
  createdAt  DateTime   @default(now())
}

model PullEntry {
  id         String     @id @default(cuid())
  date       DateTime
  bannerType BannerType
  bannerName String
  itemName   String
  result     PullResult
  pityAtPull Int
  createdAt  DateTime   @default(now())
}

// Tracks pulls made since the last logged 5-star, per banner type, so the
// dashboard can show live pity progress even between 5-star hits.
model PityCounter {
  bannerType  BannerType @id
  currentPity Int        @default(0)
  updatedAt   DateTime   @updatedAt
}
