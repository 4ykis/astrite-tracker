generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("WUWA_PRISMA_DATABASE_URL")
  directUrl = env("WUWA_DATABASE_URL")
}

enum BannerType {
  CHARACTER
  WEAPON
}

enum PullResult {
  WIN
  LOSE
}

// A Google account. Every other table is scoped to one user. The row with
// id "legacy-owner" holds data from before logins existed; it is claimed by
// the first Google login whose email matches LEGACY_OWNER_EMAIL.
model User {
  id        String   @id @default(cuid())
  googleId  String?  @unique
  email     String?  @unique
  name      String?
  image     String?
  createdAt DateTime @default(now())

  balanceEntries  BalanceEntry[]
  spendEntries    SpendEntry[]
  pullEntries     PullEntry[]
  pityCounters    PityCounter[]
  resourceEntries ResourceEntry[]
  echoBuilds      EchoBuild[]
}

model BalanceEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  amount    Int
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model SpendEntry {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       DateTime
  amount     Int
  category   BannerType
  bannerName String?
  note       String?
  createdAt  DateTime   @default(now())

  @@index([userId, date])
}

model PullEntry {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       DateTime
  bannerType BannerType
  bannerName String
  itemName   String
  result     PullResult
  pityAtPull Int
  createdAt  DateTime   @default(now())

  @@index([userId, date])
}

// Tracks pulls made since the last logged 5-star, per banner type, so the
// dashboard can show live pity progress even between 5-star hits.
model PityCounter {
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  bannerType  BannerType
  currentPity Int        @default(0)
  updatedAt   DateTime   @updatedAt

  @@id([userId, bannerType])
}

// Daily snapshot of development materials: one row per item per day. A day
// without a row for an item means the amount is unchanged since the last row.
model ResourceEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  itemId    Int
  amount    Int
  createdAt DateTime @default(now())

  @@unique([userId, date, itemId])
}

// Echo prefarm setup: one resonator plus five planned echoes. `slots` holds
// 5 × { echoId, main, subs[5] } and is always read and written as a whole.
model EchoBuild {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  characterId Int?
  weaponId    Int?
  /// Bitmask of the 8 minor forte nodes (bit i = Character.forte[i]); all unlocked by default.
  forteNodes  Int      @default(255)
  slots       Json
  position    Int      @default(0)
  collapsed   Boolean  @default(false)
  /// Marked done by hand: the header border goes green regardless of the stat targets.
  finished    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, position])
}
