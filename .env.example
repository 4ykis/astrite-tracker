# Postgres connection string (Vercel Postgres / Supabase / Neon, etc.)
# Use the pooled connection string here.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Direct (non-pooled) connection string, used by Prisma Migrate.
# If your provider only gives you one URL, use the same value for both.
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Passcode required to log in to the app. Pick your own value.
APP_PASSCODE="change-me"

# Random secret used to sign the session cookie. Generate with:
#   openssl rand -base64 32
SESSION_SECRET="change-me-too"
