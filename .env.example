# Postgres connection strings. Names match what Vercel's Postgres (Neon)
# integration auto-injects when you connect a database to this project
# (with project prefix "WUWA_"). For local dev, point these at your local
# Postgres — same value for both is fine if you don't have a separate
# pooled/direct URL.
WUWA_PRISMA_DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
WUWA_DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Google OAuth client (Google Cloud Console -> APIs & Services -> Credentials ->
# OAuth client ID, type "Web application"). Authorized redirect URI:
#   <site origin>/login/google/callback
GOOGLE_CLIENT_ID="xxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="change-me"

# Google account that takes over the data recorded before Google login
# existed. Only used once, on that account's first login. Optional.
LEGACY_OWNER_EMAIL="you@gmail.com"

# Random secret used to sign the session cookie. Generate with:
#   openssl rand -base64 32
SESSION_SECRET="change-me-too"
